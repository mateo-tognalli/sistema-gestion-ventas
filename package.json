{
  "name": "luisina-vestidos",
  "version": "1.0.0",
  "description": "Sistema Profesional de Gestión de Ventas de Vestidos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "vestidos",
    "ventas",
    "gestion"
  ],
  "author": "Luisina Vestidos",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.17.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.luisina.vestidos",
    "productName": "Luisina Vestidos",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/imagenes/logoLuisinaVestidos.png"
    },
    "portable": {
      "artifactName": "LuisinaVestidos-Portable.exe"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules",
      "src/**/*"
    ]
  }
}
